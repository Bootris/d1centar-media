# ─────────────────────────────────────────────────────────────
#  BB8 — konfiguracija (kopiraj u .env i popuni)
# ─────────────────────────────────────────────────────────────

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
BB8_MODEL=claude-opus-4-8

# --- Telegram ---
# Token dobiješ od @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# SAMO ovi Telegram user ID-jevi smeju da komanduju botu (zarezom odvojeno).
# Svoj ID dobiješ tako što napišeš /start botu — BB8 ti vrati tvoj ID.
BB8_ALLOWED_USER_IDS=

# --- GitHub ---
# PAT sa scope: repo + admin:public_key (za dodavanje deploy key-eva).
GITHUB_TOKEN=ghp_...
# Podrazumevani owner/org kad ne navedeš pun put (npr. "bootris").
GITHUB_DEFAULT_OWNER=bootris

# --- Coolify (self-hosted na tvom VPS-u) ---
# Bazni URL tvoje Coolify instance, bez / na kraju.
COOLIFY_BASE_URL=https://coolify.tvojdomen.rs
# API token: Coolify → Keys & Tokens → API tokens.
COOLIFY_API_TOKEN=
# UUID projekta i servera u koje BB8 pravi aplikacije (iz Coolify UI-ja).
COOLIFY_PROJECT_UUID=
COOLIFY_SERVER_UUID=
# Ime environmenta (obično "production").
COOLIFY_ENVIRONMENT=production

# --- Cloudflare ---
# API token sa Zone:DNS:Edit + Zone:Read.
CLOUDFLARE_API_TOKEN=
# Javni IP tvog VPS-a (na njega gledaju A-zapisi).
VPS_PUBLIC_IP=
